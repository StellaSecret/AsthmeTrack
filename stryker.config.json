{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.mutation.config.ts" },
  "coverageAnalysis": "all",
  "mutate": ["www/app/logic.js"],
  "inPlace": true,
  "reporters": ["progress", "clear-text", "html", "json"],
  "concurrency": 4,
  "timeoutMS": 10000,
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 75
  }
}